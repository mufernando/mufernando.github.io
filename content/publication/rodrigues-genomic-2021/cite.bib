@article{rodrigues_genomic_2021,
 abstract = {It is pressing to understand how animal populations evolve in response to climate change. We argue that new sequencing technologies and the use of historical samples are opening unprecedented opportunities to investigate genome-wide responses to changing environments. However, there are important challenges in interpreting the emerging findings. Firstly, it is essential to differentiate genetic adaptation from phenotypic plasticity. Secondly, it is extremely difficult to map genotype, phenotype and fitness. Thirdly, neutral demographic processes and natural selection affect genetic variation in similar ways. We argue that Drosophila melanogaster, a classical model organism with decades of climate adaptation research, is uniquely suited to overcome most of these challenges. In the near future, long term time series genome-wide datasets of D. melanogaster natural populations will provide exciting opportunities to study climate change adaptation over decades and will lay the groundwork for similar approaches in non-model systems.},
 author = {Rodrigues, Murillo F. and Cogni, Rodrigo},
 doi = {10.3389/fgene.2021.676218},
 file = {Full Text PDF:/Users/rodrigmu/Zotero/storage/5H3F8L22/Rodrigues and Cogni - 2021 - Genomic Responses to Climate Change Making the Most of the Drosophila Model.pdf:application/pdf},
 issn = {1664-8021},
 journal = {Frontiers in Genetics},
 keywords = {climate adaptation, cline, Drosophila, genomic adaptation, Global Warming, historical samples, natural selection, Wild populations},
 language = {English},
 month = {July},
 publisher = {Frontiers},
 shorttitle = {Genomic Responses to Climate Change},
 title = {Genomic Responses to Climate Change: Making the Most of the Drosophila Model},
 url = {https://www.frontiersin.org/journals/genetics/articles/10.3389/fgene.2021.676218/full},
 urldate = {2026-10-16},
 volume = {12},
 year = {2021}
}
