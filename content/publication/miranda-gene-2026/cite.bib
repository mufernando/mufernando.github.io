 doi = {10.1101/2025.11.28.691231},
 file = {Full Text PDF:/Users/rodrigmu/Zotero/storage/FFEBJHAN/Miranda et al. - 2026 - Gene flow erodes spatial genomic clines while selection preserves adaptive loci over hundreds of gen.pdf:application/pdf},
